# ~/.zshrc, generated by chezmoi from ~/conf/dot_zshrc.tmpl. Edit the template, then `chezmoi apply`.
# One file for the laptop (darwin) and Podium workspaces (linux); the OS branches hold what differs.
{{- if eq .chezmoi.os "darwin" }}

export GOPATH=/Users/$USER/go
export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH=$PATH:$GOPATH/bin
export PATH="/usr/local/opt/python/libexec/bin:$PATH"
export PATH="/usr/local/opt/gnu-sed/libexec/gnubin:$PATH"
export PATH="/opt/homebrew/bin:$PATH"
export PATH="$PATH:$HOME/.foundry/bin"
export PATH="$PATH:/opt/homebrew/opt/libpq/bin"
export PATH="$PATH:/Applications/WebStorm.app/Contents/MacOS"
export KUBECFG_JPATH="/usr/local/opt/ksonnetlib/share/ksonnet-lib"

export KOPS_FEATURE_FLAGS="+DrainAndValidateRollingUpdate"
export KOPS_STATE_STORE=s3://kops-state-loa

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="yoni"
plugins=(git kubectl terraform)
source $ZSH/oh-my-zsh.sh

# A shell that starts in $HOME lands in the repo; one opened in a worktree (Herdr space) stays there.
[ "$PWD" = "$HOME" ] && cd ~/dev/act
{{- else }}

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="yoni"
plugins=(git docker kubectl zsh-autosuggestions zsh-syntax-highlighting)
source $ZSH/oh-my-zsh.sh

# Enter the repo first: the shared block below runs mise-managed tools that only resolve inside its mise.toml.
[ "$PWD" = "$HOME" ] && cd /workspace/act 2>/dev/null

[ -f /etc/devcontainer/env.sh ] && source /etc/devcontainer/env.sh
export POWERLEVEL9K_DISABLE_GITSTATUS=true
export NODE_OPTIONS="--max-old-space-size=4096"
{{- end }}

# ---- shared: after oh-my-zsh, so these aliases override the git plugin's ----
export EDITOR=vim
export KUBE_EDITOR=vim
export DISABLE_UNTRACKED_FILES_DIRTY=true
export GPG_TTY=$(tty)

export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/conf/bin:$PATH"

alias kc=kubectl
alias kcx=kubectx
alias tf=terraform
alias hist="history -i"
alias ggl="git log --pretty=format:'%C(auto)%H %D%Creset%n Date: %cD (%cr) %n Author: %C(green)%cn %n %Creset %n   %s%n%n%w(120, 3, 4)%b'"

rgrep() { grep -r "$@" *; }

alias ll="ls -ltrh"
alias gp='git pull'
alias gs='git status'
alias ga='git add'
alias gb='git branches'
alias gbd='git branch -D'
alias gc='git commit'
alias gd='git difftool'
alias got='git '
alias get='git '
alias gi='git '
alias gitp='git '
alias glog='git log'
alias gut='git '

# Completion for git-branch-cleanup.sh
_git_branch_cleanup() {
    local branches
    branches=(${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads/ 2>/dev/null)"})
    _describe 'branch' branches
}
compdef _git_branch_cleanup git-branch-cleanup.sh
compdef _git_branch_cleanup cleanup-branch

[ -f "$HOME/.hooks" ] && source $HOME/.hooks
eval "$(mise activate zsh)"
mise which tilt &>/dev/null && source <(tilt completion zsh)

# >>> act-dx completion >>>
if [ -f "$HOME/.config/act-dx/completions/dx.zsh" ]; then
  source "$HOME/.config/act-dx/completions/dx.zsh"
fi
# <<< act-dx completion <<<
{{- if eq .chezmoi.os "darwin" }}

alias gk='gitk --all&'
alias gx='gitx --all'
alias g=mvim
alias act='cd $HOME/dev/act && webstorm .'

test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"

# Add RVM to PATH for scripting. Make sure this is the last PATH variable change.
export PATH="$PATH:$HOME/.rvm/bin"

autoload -U +X bashcompinit && bashcompinit
complete -o nospace -C /usr/local/bin/terraform terraform
{{- end }}
