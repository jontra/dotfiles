# ~/.gitconfig, generated by chezmoi from ~/conf/private_dot_gitconfig.tmpl. Edit the template, then `chezmoi apply`.
# Identity and tools differ per machine; aliases and defaults are shared. Global ignores: ~/.config/git/ignore.
[user]
	name = Yoni Londner
{{- if eq .chezmoi.os "darwin" }}
	email = jontra@gmail.com
	signingkey = 30FE1D9BA47D6467
[credential]
	helper = cache --timeout=86400
[diff]
	tool = gvimdiff
[merge]
	tool = gvimdiff
[difftool]
	prompt = false
[core]
	pager = less -F -X
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path =
[mergetool "sourcetree"]
	cmd = /Applications/SourceTree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[hub]
	host = github.com
# Repos with an act-security remote authenticate with the work key instead of the personal one.
[includeIf "hasconfig:remote.*.url:git@github.com:act-security/**"]
	path = ~/.config/git/act.inc
{{- else }}
	email = yoni.londner@act.security
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
{{- end }}
[push]
	default = current
	autoSetupRemote = true
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[commit]
	gpgsign = false
[tag]
	gpgsign = false
[alias]
  co = checkout
  dt = difftool
  difftoll = difftool
  ci = commit
  st = status
  br = branch
  hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short
  type = cat-file -t
  dump = cat-file -p
  tpull = pull
  tpush = push
  ull = pull
  lol = log --pretty=format:'%C(auto)%H %D%Creset%n Date: %cD (%cr) %n Author: %C(green)%cn %n %Creset %n   %s%n%n%w(120, 3, 4)%b'
  # List all branches with dates
  branches = for-each-ref --sort=-committerdate refs/heads/ --format='%(HEAD) %(color:yellow)%(refname:short)%(color:reset) - %(color:red)%(committerdate:relative)%(color:reset) - %(contents:subject)'
  # List recent branches
  recent = for-each-ref --sort=-committerdate refs/heads/ --format='%(refname:short) - %(committerdate:relative)' --count=10
  # Simple branch list
  bl = branch --format='%(refname:short)'
