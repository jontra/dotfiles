"
" gvimdiff
"
if &diff
  " ignore whitespaces
  noremap <a-i> :set diffopt=context:1000,filler,iwhite<cr>
  " unfold
  noremap <F12> <c-W>hzRgg<c-W>lzRgg
  " go right
  noremap <F11> <c-W>l
  " go left
  noremap <F10> <c-W>h
  " get from right to left (must be on left!!)
  noremap <silent> <f2> :diffget<cr>
  " get from left to right (must be on left!!)
  noremap <silent> <f3> :diffput<cr>
  " next match
  map <tab> ]czz
  " previous match
  map <s-tab> [czz
  " update the diff
  map <silent> <f5> :diffup<cr>
  imap <silent> <f5> :diffup<cr>
  " quit  (well, duhh !)
  cnoremap q qa
  set co=240
  set lines=76
  exe "normal \<c-w>="
  "always split equally at the middle
  set noea
  set guioptions-=rRlL
  "fold manually only
  set fdm=manual
  set diffopt=filler,context:5000
  " set guifont=Lucida_Console:h8
  " set guifont=Consolas:h9:b:cANSI
endif

