"This is for showmarks script
"set compatible

fun VSplitToggle()
    if !exists("g:vsplit_on")
	let g:vsplit_on = 0
	let g:columns_old = &columns
    endif
    let g:vsplit_on = !g:vsplit_on
    if g:vsplit_on == 1
	:se columns=165
	:vsplit
    else
	" closes all windows except current window 
	:only
	exe ":set columns=" . g:columns_old 
    endif
endfun
fun CscopeZtoolsToggle()
    if !exists("g:cscope_ztools_on")
	let g:cscope_ztools_on = 0
    endif
    let g:cscope_ztools_on = !g:cscope_ztools_on
    if g:cscope_ztools_on == 1
	:cal CscopeCTagsInit()
	:cs add ~/cscope_ztools.out c:/ztools
    else
	:cs kill 1
    endif
endfun

